# Database Connection (Render PostgreSQL in production, SQLite in local dev)
DATABASE_URL=postgresql://user:password@hostname:5432/career_planet_db

# Security & JWT Configuration
SECRET_KEY=your_production_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Allowed Origins (Vercel Frontend URL & local)
ALLOWED_ORIGINS=https://career-planet.vercel.app,http://localhost:5173

# AI & Email Integrations (Replace with your actual keys in private .env)
GROQ_API_KEY=your_groq_api_key_here
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
